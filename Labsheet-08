// Q1. Create a Flutter Notes application
// that stores notes in SQLite and displays them.

import 'package:flutter/material.dart';
import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';

void main() => runApp(MaterialApp(home: Notes()));

class Notes extends StatefulWidget {
  State<Notes> createState() => _NotesState();
}

class _NotesState extends State<Notes> {
  Database? db;
  List notes = [];

  void initState() {
    super.initState();
    open();
  }

  Future open() async {
    db = await openDatabase(
      join(await getDatabasesPath(), 'notes.db'),
      version: 1,
      onCreate: (d, v) => d.execute(
        'CREATE TABLE notes(id INTEGER PRIMARY KEY, title TEXT, content TEXT)'));
    load();
  }

  void load() async {
    notes = await db!.query('notes');
    setState(() {});
  }

  Widget build(context) => Scaffold(
    appBar: AppBar(title: Text('Notes')),
    body: ListView(children: notes.map((n) =>
      ListTile(title: Text(n['title']),
        subtitle: Text(n['content']))).toList()),
    floatingActionButton: FloatingActionButton(
      onPressed: () async {
        await db!.insert('notes',
          {'title': 'My Note', 'content': 'Hello Flutter'});
        load();
      },
      child: Icon(Icons.add),
    ),
  );
}

