      TextField(controller: name, decoration: InputDecoration(labelText: 'Name')),
      ElevatedButton(onPressed: () async {
        if (name.text.isNotEmpty) {
          var db = await getDB();
          await db.insert('students', {'name': name.text});
          Navigator.pop(context);
        }
      }, child: Text('Save')),
    ]),
  );
}

class StudentList extends StatefulWidget {
  State<StudentList> createState() => _StudentListState();
}

class _StudentListState extends State<StudentList> {
  List data = [];

  void initState() {
    super.initState();
    load();
  }

  void load() async {
    var db = await getDB();
    data = await db.query('students');
    setState(() {});
  }

  Widget build(context) => Scaffold(
    appBar: AppBar(title: Text('Student List')),
    body: ListView(children: data.map((s) => ListTile(
      title: Text(s['name']),
      onTap: () async {
        var db = await getDB();
        await db.update('students', {'name': 'Updated Student'},
          where: 'id=?', whereArgs: [s['id']]);
        load();
      },
      trailing: IconButton(icon: Icon(Icons.delete), onPressed: () async {
        bool? ok = await showDialog(
          context: context,
          builder: (_) => AlertDialog(
            title: Text('Delete Student?'),
            actions: [
              TextButton(onPressed: () => Navigator.pop(context, false),
                child: Text('No')),
              TextButton(onPressed: () => Navigator.pop(context, true),
                child: Text('Yes')),
            ],
          ),
        );
        if (ok == true) {
          var db = await getDB();
          await db.delete('students', where: 'id=?', whereArgs: [s['id']]);
          load();
        }
      }),
    )).toList()),
  );
}

