            builder: (_) => Scaffold(body: Center(child: Text('Welcome Home')))));
        } else {
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text('Invalid Login')));
        }
      }, child: Text('Login')),
    ]),
  );
}

