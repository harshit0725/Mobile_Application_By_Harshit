  State<Expenses> createState() => _ExpensesState();
}

class _ExpensesState extends State<Expenses> {
  Database? db;
  double total = 0;

  void initState() {
    super.initState();
    open();
  }

  Future open() async {
    db = await openDatabase(join(await getDatabasesPath(), 'e9.db'),
      version: 1, onCreate: (d, v) => d.execute(
      'CREATE TABLE expenses(id INTEGER PRIMARY KEY, title TEXT, amount REAL)'));
    calculate();
  }

  void calculate() async {
    var r = await db!.rawQuery('SELECT SUM(amount) AS total FROM expenses');
    total = (r.first['total'] as num?)?.toDouble() ?? 0;
    setState(() {});
  }

  Widget build(context) => Scaffold(
    appBar: AppBar(title: Text('Total Expense')),
    body: Center(child: Text('Total: ₹$total')),
    floatingActionButton: FloatingActionButton(
      onPressed: () async {
        await db!.insert('expenses',
          {'title': 'Shopping', 'amount': 500.0});
        calculate();
      },
      child: Icon(Icons.add),
    ),
  );
}

