// Q12. Validate username and password using SQLite
// and navigate to Home screen on success.

import 'package:flutter/material.dart';
import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';

void main() => runApp(MaterialApp(home: Login()));

class Login extends StatelessWidget {
  final user = TextEditingController();
  final pass = TextEditingController();

  Widget build(context) => Scaffold(
    appBar: AppBar(title: Text('Login')),
    body: Column(children: [
      TextField(controller: user, decoration: InputDecoration(labelText: 'Email')),
      TextField(controller: pass, decoration: InputDecoration(labelText: 'Password')),
      ElevatedButton(onPressed: () async {
        var db = await openDatabase(join(await getDatabasesPath(), 'r11.db'),
          version: 1, onCreate: (d, v) => d.execute(
          'CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT, email TEXT, pass TEXT)'));
        var r = await db.query('users', where: 'email=? AND pass=?',
          whereArgs: [user.text, pass.text]);
