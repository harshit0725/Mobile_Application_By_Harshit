// Q1. Parse JSON array into List of Student objects.

import 'dart:convert';

class Student {
  String name;
  Student(this.name);

  factory Student.fromJson(Map j) =>
      Student(j['name']);
}

void main() {
  var data = '[{"name":"Aman"},{"name":"Rahul"}]';
  List list = jsonDecode(data);
  var students = list.map((e) =>
      Student.fromJson(e)).toList();

  students.forEach((s) => print(s.name));
}

