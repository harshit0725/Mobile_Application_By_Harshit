// Q9. Convert API data into objects using fromJson().

import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';

class Post {
  String title;
  Post.fromJson(Map j) : title = j['title'];
}

void main() => runApp(MaterialApp(home: Home()));

class Home extends StatelessWidget {
  Future getData() async {
    var r = await http.get(Uri.parse(
      'https://jsonplaceholder.typicode.com/posts'));
    return (jsonDecode(r.body) as List)
        .map((e) => Post.fromJson(e)).toList();
  }

  @override
  Widget build(BuildContext c) => Scaffold(
    body: FutureBuilder(
      future: getData(),
      builder: (c, s) {
        if (!s.hasData) return CircularProgressIndicator();
        return ListView(
          children: s.data.map<Widget>(
            (p) => ListTile(title: Text(p.title))
          ).toList(),
        );
      },
    ),
  );
}

// Q10. Handle API errors and display Retry button.

import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(MaterialApp(home: Home()));

class Home extends StatefulWidget {
  @override
  State<Home> createState() => _HomeState();
}

class _HomeState extends State<Home> {
  Future getData() async {
    var r = await http.get(Uri.parse(
      'https://jsonplaceholder.typicode.com/posts'));
    if (r.statusCode != 200) throw Exception();
    return 'Data Loaded';
  }

  @override
  Widget build(BuildContext c) => Scaffold(
    body: FutureBuilder(
      future: getData(),
      builder: (c, s) {
        if (s.hasError)
          return ElevatedButton(
            onPressed: () => setState(() {}),
            child: Text('Retry'));
        if (!s.hasData) return CircularProgressIndicator();
        return Text(s.data);
      },
    ),
  );
}

