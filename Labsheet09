// Q14. Send title and body using http.post().

import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(MaterialApp(home: Home()));

class Home extends StatelessWidget {
  final t = TextEditingController();
  final b = TextEditingController();

  void send() async {
    var r = await http.post(
      Uri.parse('https://jsonplaceholder.typicode.com/posts'),
      body: {'title': t.text, 'body': b.text},
    );
    print(r.body);
  }

  @override
  Widget build(BuildContext c) => Scaffold(
    body: Column(children: [
      TextField(controller: t),
      TextField(controller: b),
      ElevatedButton(onPressed: send, child: Text('Send')),
    ]),
  );
}

// Q15. Fetch products and display in GridView.

import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';

void main() => runApp(MaterialApp(home: Home()));

class Home extends StatelessWidget {
  Future getData() async {
    var r = await http.get(Uri.parse(
      'https://fakestoreapi.com/products'));
    return jsonDecode(r.body);
  }

  @override
  Widget build(BuildContext c) => Scaffold(
    appBar: AppBar(title: Text('Products')),
    body: FutureBuilder(
      future: getData(),
      builder: (c, s) {
        if (s.hasError) return Text('Error');
        if (!s.hasData) return CircularProgressIndicator();
        return GridView.builder(
          itemCount: s.data.length,
          gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 2),
          itemBuilder: (c, i) {
            var p = s.data[i];
            return Column(children: [
              Expanded(child: Image.network(p['image'])),
              Text(p['title']),
              Text('\$${p['price']}'),
            ]);
          },
        );
      },
    ),
  );
}


